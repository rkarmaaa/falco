+/**
+ * @file src/platform/windows/audio_onscreen.h
+ * @brief Declarations for capturing only the audio of applications visible on the streamed display.
+ */
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+// local includes
+#include "src/platform/common.h"
+
+namespace platf::audio {
+  /**
+   * @brief Create a capture stream that mixes only the audio of processes with a window visible on the streamed display.
+   *
+   * Uses Windows process loopback capture (Windows 10 2004 or later). Voice chat applications and the
+   * processes listed in `audio_exclude_apps` are never captured, even when visible.
+   *
+   * @param channels Number of channels requested by the client.
+   * @param channel_mask WAVEFORMATEXTENSIBLE channel mask for the requested layout.
+   * @param sample_rate Audio sample rate in hertz.
+   * @param frame_size Number of samples per channel in each audio frame.
+   * @param continuous Whether silence should be emitted while nothing is playing.
+   * @return Capture stream, or an empty pointer when process loopback is not available.
+   */
+  std::unique_ptr<mic_t> make_onscreen_mic(std::uint32_t channels, std::uint32_t channel_mask, std::uint32_t sample_rate, std::uint32_t frame_size, bool continuous);
+
+  /**
+   * @brief Build the lowercase list of executable names that are never captured.
+   *
+   * @param extra Comma-separated executable names from `audio_exclude_apps`.
+   * @return Built-in voice chat applications followed by the extra names.
+   */
+  std::vector<std::wstring> excluded_apps(const std::string &extra);
+
+  /**
+   * @brief Process information used to choose which audio sources to capture.
+   */
+  struct process_node_t {
+    std::uint32_t pid;  ///< Process identifier.
+    std::uint32_t parent;  ///< Parent process identifier, valid only when `parent_valid` is true.
+    bool parent_valid;  ///< Whether the parent still is the process that created this one.
+    std::wstring exe;  ///< Lowercase executable name.
+  };
+
+  /**
+   * @brief Choose which processes to capture with process-tree loopback.
+   *
+   * Each capture includes the whole process tree, so a candidate whose ancestor is also captured is
+   * dropped (its audio would be mixed twice), and a candidate whose tree contains an excluded
+   * application is skipped (its audio would leak).
+   *
+   * @param candidates Processes owning a visible window, in any order.
+   * @param processes Snapshot of all processes.
+   * @param excluded Lowercase executable names that must never be captured.
+   * @return Process identifiers to capture.
+   */
+  std::vector<std::uint32_t> select_capture_roots(const std::vector<std::uint32_t> &candidates, const std::vector<process_node_t> &processes, const std::vector<std::wstring> &excluded);
+}  // namespace platf::audio
