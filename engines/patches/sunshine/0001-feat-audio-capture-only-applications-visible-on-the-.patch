@@ -0,0 +1,144 @@
+/**
+ * @file tests/unit/platform/windows/test_audio_onscreen.cpp
+ * @brief Tests for choosing which processes the on-screen audio capture records.
+ */
+
+#ifdef _WIN32
+
+  // standard includes
+  #include <algorithm>
+  #include <chrono>
+  #include <cmath>
+  #include <cstdlib>
+  #include <iostream>
+
+  // lib includes
+  #include <gtest/gtest.h>
+
+  // local includes
+  #include "src/platform/windows/audio_onscreen.h"
+
+using platf::audio::excluded_apps;
+using platf::audio::make_onscreen_mic;
+using platf::audio::process_node_t;
+using platf::audio::select_capture_roots;
+
+namespace {
+  /**
+   * @brief Process tree used by the tests.
+   *
+   * explorer(10) → steam(20) → game(21) → game helper(22)
+   * explorer(10) → discord(30) → discord audio(31)
+   * explorer(10) → chrome(40)
+   * launcher(50) → discord(51)
+   * stale(60), whose parent id 21 was reused: not really a child of the game.
+   *
+   * @return Snapshot of the processes.
+   */
+  std::vector<process_node_t> tree() {
+    return {
+      {10, 1, true, L"explorer.exe"},
+      {20, 10, true, L"steam.exe"},
+      {21, 20, true, L"game.exe"},
+      {22, 21, true, L"helper.exe"},
+      {30, 10, true, L"discord.exe"},
+      {31, 30, true, L"discord.exe"},
+      {40, 10, true, L"chrome.exe"},
+      {50, 10, true, L"launcher.exe"},
+      {51, 50, true, L"discord.exe"},
+      {60, 21, false, L"stale.exe"},
+    };
+  }
+
+  /**
+   * @brief Sort a pid list for comparison.
+   *
+   * @param v Process ids.
+   * @return Sorted copy.
+   */
+  std::vector<std::uint32_t> sorted(std::vector<std::uint32_t> v) {
+    std::sort(v.begin(), v.end());
+    return v;
+  }
+}  // namespace
+
+TEST(AudioOnscreenTest, ExcludedAppsIncludeVoiceChatAndExtras) {
+  auto list = excluded_apps(" Spotify , obs64.exe,,");
+  EXPECT_NE(std::find(list.begin(), list.end(), L"discord.exe"), list.end());
+  EXPECT_NE(std::find(list.begin(), list.end(), L"spotify.exe"), list.end());
+  EXPECT_NE(std::find(list.begin(), list.end(), L"obs64.exe"), list.end());
+  EXPECT_EQ(std::count(list.begin(), list.end(), L"discord.exe"), 1);
+}
+
+TEST(AudioOnscreenTest, VisibleGameAndBrowserAreCaptured) {
+  EXPECT_EQ(sorted(select_capture_roots({21, 40}, tree(), excluded_apps(""))), (std::vector<std::uint32_t> {21, 40}));
+}
+
+TEST(AudioOnscreenTest, VoiceChatIsNeverCapturedEvenWhenVisible) {
+  EXPECT_EQ(select_capture_roots({30, 21}, tree(), excluded_apps("")), (std::vector<std::uint32_t> {21}));
+}
+
+TEST(AudioOnscreenTest, ShellIsNeverARoot) {
+  EXPECT_TRUE(select_capture_roots({10}, tree(), excluded_apps("")).empty());
+}
+
+TEST(AudioOnscreenTest, DescendantOfACapturedTreeIsNotCapturedTwice) {
+  EXPECT_EQ(select_capture_roots({20, 21, 22}, tree(), excluded_apps("")), (std::vector<std::uint32_t> {20}));
+}
+
+TEST(AudioOnscreenTest, TreeContainingVoiceChatIsSkipped) {
+  EXPECT_TRUE(select_capture_roots({50}, tree(), excluded_apps("")).empty());
+}
+
+TEST(AudioOnscreenTest, ReusedParentIdIsNotAnAncestor) {
+  EXPECT_EQ(sorted(select_capture_roots({21, 60}, tree(), excluded_apps(""))), (std::vector<std::uint32_t> {21, 60}));
+}
+
+TEST(AudioOnscreenTest, UserExcludedAppIsSkipped) {
+  EXPECT_TRUE(select_capture_roots({40}, tree(), excluded_apps("chrome")).empty());
+}
+
+TEST(AudioOnscreenTest, UnknownProcessIsIgnored) {
+  EXPECT_TRUE(select_capture_roots({999}, tree(), excluded_apps("")).empty());
+}
+
+TEST(AudioOnscreenTest, CaptureDeliversFramesAtStreamRate) {
+  constexpr std::uint32_t frame = 240;  // 5 ms at 48 kHz
+  auto mic = make_onscreen_mic(2, 0x3, 48000, frame, true);
+  if (!mic) {
+    GTEST_SKIP() << "Process loopback is not available on this system";
+  }
+  std::vector<float> buffer(frame * 2, 1.0f);
+  auto start = std::chrono::steady_clock::now();
+  for (int i = 0; i < 100; ++i) {
+    ASSERT_EQ(mic->sample(buffer), platf::capture_e::ok);
+  }
+  auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+  EXPECT_GE(elapsed, 450);  // 100 frames of 5 ms
+  EXPECT_LE(elapsed, 700);
+  EXPECT_TRUE(std::all_of(buffer.begin(), buffer.end(), [](float v) {
+    return v >= -1.0f && v <= 1.0f;
+  }));
+}
+
+TEST(AudioOnscreenTest, ManualProbePrintsPeak) {
+  // Manual check: FALCO_AUDIO_PROBE=<seconds> while something plays in a visible window
+  auto seconds = std::getenv("FALCO_AUDIO_PROBE");
+  if (!seconds) {
+    GTEST_SKIP() << "Set FALCO_AUDIO_PROBE to run";
+  }
+  constexpr std::uint32_t frame = 480;  // 10 ms
+  auto mic = make_onscreen_mic(2, 0x3, 48000, frame, true);
+  ASSERT_TRUE(mic);
+  std::vector<float> buffer(frame * 2);
+  float peak = 0;
+  for (int i = 0, n = std::atoi(seconds) * 100; i < n; ++i) {
+    ASSERT_EQ(mic->sample(buffer), platf::capture_e::ok);
+    for (auto v : buffer) {
+      peak = std::max(peak, std::abs(v));
+    }
+  }
+  std::cout << "FALCO_AUDIO_PEAK " << peak << std::endl;
+}
+
+#endif
