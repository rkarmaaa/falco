index 00000000..f4f17780
--- /dev/null
+++ b/src/platform/windows/audio_onscreen.cpp
@@ -0,0 +1,1004 @@
+/**
+ * @file src/platform/windows/audio_onscreen.cpp
+ * @brief Capture only the audio of applications visible on the streamed display (Falco).
+ *
+ * Every half second a watcher thread lists the top-level windows of the streamed display in Z-order,
+ * keeps those that are actually visible (not minimized, cloaked or covered by other windows) and
+ * opens a process loopback capture for each owning process tree. A reader thread drains the captures
+ * into per-source buffers and `sample()` mixes them at the stream's frame rate.
+ */
+// standard includes
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cwctype>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <unordered_map>
+
+// platform includes
+#include <windows.h>
+#include <Audioclient.h>
+#include <dwmapi.h>
+#include <mmdeviceapi.h>
+#include <tlhelp32.h>
+
+#if __has_include(<audioclientactivationparams.h>)
+  #include <audioclientactivationparams.h>
+#else
+/**
+ * @brief Activation type for `ActivateAudioInterfaceAsync` (missing from older MinGW headers).
+ */
+typedef enum AUDIOCLIENT_ACTIVATION_TYPE {
+  AUDIOCLIENT_ACTIVATION_TYPE_DEFAULT = 0,  ///< Regular device activation.
+  AUDIOCLIENT_ACTIVATION_TYPE_PROCESS_LOOPBACK = 1,  ///< Process loopback capture.
+} AUDIOCLIENT_ACTIVATION_TYPE;
+
+/**
+ * @brief Whether the target process tree is included or excluded from the capture.
+ */
+typedef enum PROCESS_LOOPBACK_MODE {
+  PROCESS_LOOPBACK_MODE_INCLUDE_TARGET_PROCESS_TREE = 0,  ///< Capture only the target process tree.
+  PROCESS_LOOPBACK_MODE_EXCLUDE_TARGET_PROCESS_TREE = 1,  ///< Capture everything except the target process tree.
+} PROCESS_LOOPBACK_MODE;
+
+/**
+ * @brief Process loopback parameters.
+ */
+typedef struct AUDIOCLIENT_PROCESS_LOOPBACK_PARAMS {
+  DWORD TargetProcessId;  ///< Root of the captured process tree.
+  PROCESS_LOOPBACK_MODE ProcessLoopbackMode;  ///< Include or exclude the tree.
+} AUDIOCLIENT_PROCESS_LOOPBACK_PARAMS;
+
+/**
+ * @brief Parameters passed to `ActivateAudioInterfaceAsync` in a VT_BLOB.
+ */
+typedef struct AUDIOCLIENT_ACTIVATION_PARAMS {
+  AUDIOCLIENT_ACTIVATION_TYPE ActivationType;  ///< Activation type.
+  AUDIOCLIENT_PROCESS_LOOPBACK_PARAMS ProcessLoopbackParams;  ///< Used for process loopback.
+} AUDIOCLIENT_ACTIVATION_PARAMS;
+
+  #define VIRTUAL_AUDIO_DEVICE_PROCESS_LOOPBACK L"VAD\\Process_Loopback"
+#endif
+
+// local includes
+#include "audio_onscreen.h"
+#include "src/config.h"
+#include "src/logging.h"
+#include "src/utility.h"
+#include "utf_utils.h"
+
+namespace platf::audio {
+  namespace {
+    using namespace std::literals;
+
+    /// Voice chat applications: their audio is the guests' own voices, never stream it back.
+    constexpr std::array<const wchar_t *, 21> builtin_excluded {
+      L"discord.exe",
+      L"discordptb.exe",
+      L"discordcanary.exe",
+      L"discorddevelopment.exe",
+      L"teamspeak.exe",
+      L"ts3client_win64.exe",
+      L"ts3client_win32.exe",
+      L"ms-teams.exe",
+      L"teams.exe",
+      L"zoom.exe",
+      L"mumble.exe",
+      L"skype.exe",
+      L"slack.exe",
+      L"whatsapp.exe",
+      L"whatsapp.root.exe",
+      L"telegram.exe",
+      L"signal.exe",
+      L"guilded.exe",
+      L"element.exe",
+      L"revolt.exe",
+      L"vesktop.exe",
+    };
+
+    /// Shell processes: capturing their tree would include every application started from the desktop.
+    constexpr std::array<const wchar_t *, 12> shell_processes {
+      L"explorer.exe",
+      L"applicationframehost.exe",
+      L"shellexperiencehost.exe",
+      L"startmenuexperiencehost.exe",
+      L"searchhost.exe",
+      L"searchapp.exe",
+      L"textinputhost.exe",
+      L"lockapp.exe",
+      L"dwm.exe",
+      L"sunshine.exe",
+      L"svchost.exe",
+      L"services.exe",
+    };
+
+    constexpr auto refresh_interval = 500ms;  ///< How often the visible windows are listed.
+    constexpr auto grace_period = 1500ms;  ///< How long a source survives after its window disappears.
+    constexpr std::size_t max_sources = 32;  ///< Upper bound on simultaneous captures.
+
+    /**
+     * @brief Lowercase a wide string.
+     *
+     * @param s Input string.
+     * @return Lowercase copy.
+     */
+    std::wstring lower(std::wstring s) {
+      std::transform(s.begin(), s.end(), s.begin(), [](wchar_t c) {
+        return static_cast<wchar_t>(std::towlower(c));
+      });
+      return s;
+    }
+
+    /**
+     * @brief Whether a name is in a list.
+     *
+     * @param list Candidate names.
+     * @param name Lowercase name to look for.
+     * @return True when found.
+     */
+    template<class List>
+    bool contains(const List &list, const std::wstring &name) {
+      return std::any_of(std::begin(list), std::end(list), [&](const auto &n) {
+        return name == n;
+      });
+    }
+
+    /**
+     * @brief Creation time of a process, or zero when it cannot be read.
+     *
+     * @param pid Process identifier.
+     * @return Creation time in FILETIME units.
+     */
+    std::uint64_t creation_time(DWORD pid) {
+      HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+      if (!h) {
+        return 0;
+      }
+      FILETIME created {}, exited {}, kernel {}, user {};
+      std::uint64_t t = 0;
+      if (GetProcessTimes(h, &created, &exited, &kernel, &user)) {
+        t = (static_cast<std::uint64_t>(created.dwHighDateTime) << 32) | created.dwLowDateTime;
+      }
+      CloseHandle(h);
+      return t;
+    }
+
+    /**
+     * @brief Snapshot of all running processes with validated parent links.
+     *
+     * @return One node per process.
+     */
+    std::vector<process_node_t> snapshot_processes() {
+      std::vector<process_node_t> out;
+      HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+      if (snap == INVALID_HANDLE_VALUE) {
+        return out;
+      }
+      PROCESSENTRY32W entry {};
+      entry.dwSize = sizeof(entry);
+      for (BOOL ok = Process32FirstW(snap, &entry); ok; ok = Process32NextW(snap, &entry)) {
+        out.push_back({entry.th32ProcessID, entry.th32ParentProcessID, true, lower(entry.szExeFile)});
+      }
+      CloseHandle(snap);
+
+      // A parent id may have been reused by a newer process: then it is not the real parent
+      std::unordered_map<DWORD, std::uint64_t> times;
+      auto time_of = [&](DWORD pid) {
+        auto it = times.find(pid);
+        if (it == times.end()) {
+          it = times.emplace(pid, creation_time(pid)).first;
+        }
+        return it->second;
+      };
+      for (auto &p : out) {
+        auto child = time_of(p.pid);
+        auto parent = time_of(p.parent);
+        if (child && parent && parent > child) {
+          p.parent_valid = false;
+        }
+      }
+      return out;
+    }
+
+    /**
+     * @brief Rectangle of the display being streamed.
+     *
+     * @return Monitor rectangle; the primary monitor when `output_name` does not match one.
+     */
+    RECT streamed_monitor_rect() {
+      struct ctx_t {
+        std::wstring want;
+        RECT rect;
+        bool found;
+      } ctx {utf_utils::from_utf8(config::video.output_name), {}, false};
+
+      if (!ctx.want.empty()) {
+        EnumDisplayMonitors(nullptr, nullptr, [](HMONITOR monitor, HDC, LPRECT, LPARAM param) -> BOOL {
+          auto c = reinterpret_cast<ctx_t *>(param);
+          MONITORINFOEXW info {};
+          info.cbSize = sizeof(info);
+          if (GetMonitorInfoW(monitor, &info) && c->want == info.szDevice) {
+            c->rect = info.rcMonitor;
+            c->found = true;
+            return FALSE;
+          }
+          return TRUE;
+        },
+                            reinterpret_cast<LPARAM>(&ctx));
+      }
+      if (!ctx.found) {
+        MONITORINFO info {};
+        info.cbSize = sizeof(info);
+        GetMonitorInfoW(MonitorFromPoint({0, 0}, MONITOR_DEFAULTTOPRIMARY), &info);
+        ctx.rect = info.rcMonitor;
+      }
+      return ctx.rect;
+    }
+
+    /**
+     * @brief Area in pixels of a GDI region.
+     *
+     * @param region Region handle.
+     * @return Sum of the areas of its rectangles.
+     */
+    std::int64_t region_area(HRGN region) {
+      DWORD size = GetRegionData(region, 0, nullptr);
+      if (!size) {
+        return 0;
+      }
+      std::vector<std::uint8_t> buf(size);
+      auto data = reinterpret_cast<RGNDATA *>(buf.data());
+      if (!GetRegionData(region, size, data)) {
+        return 0;
+      }
+      auto rects = reinterpret_cast<const RECT *>(data->Buffer);
+      std::int64_t area = 0;
+      for (DWORD i = 0; i < data->rdh.nCount; ++i) {
+        area += static_cast<std::int64_t>(rects[i].right - rects[i].left) * (rects[i].bottom - rects[i].top);
+      }
+      return area;
+    }
+
+    /**
+     * @brief Whether a window can be seen: shown, not minimized, not cloaked and not click-through.
+     *
+     * @param hwnd Window handle.
+     * @return True when the window paints visible pixels.
+     */
+    bool window_is_drawn(HWND hwnd) {
+      if (!IsWindowVisible(hwnd) || IsIconic(hwnd)) {
+        return false;
+      }
+      DWORD cloaked = 0;
+      if (SUCCEEDED(DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &cloaked, sizeof(cloaked))) && cloaked) {
+        return false;
+      }
+      auto ex = static_cast<DWORD>(GetWindowLongPtrW(hwnd, GWL_EXSTYLE));
+      if (ex & WS_EX_TRANSPARENT) {
+        return false;  // overlays that let clicks through
+      }
+      if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) {
+        return false;  // taskbar, tooltips, notification popups
+      }
+      if (ex & WS_EX_LAYERED) {
+        BYTE alpha = 255;
+        DWORD flags = 0;
+        if (GetLayeredWindowAttributes(hwnd, nullptr, &alpha, &flags) && (flags & LWA_ALPHA) && alpha == 0) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    /**
+     * @brief Owner of a UWP frame: the hosted app's process instead of ApplicationFrameHost.
+     *
+     * @param hwnd Frame window.
+     * @param frame_pid Process owning the frame.
+     * @return Hosted app process, or `frame_pid` when there is none.
+     */
+    DWORD uwp_owner(HWND hwnd, DWORD frame_pid) {
+      struct ctx_t {
+        DWORD frame;
+        DWORD found;
+      } ctx {frame_pid, 0};
+      EnumChildWindows(hwnd, [](HWND child, LPARAM param) -> BOOL {
+        auto c = reinterpret_cast<ctx_t *>(param);
+        DWORD pid = 0;
+        GetWindowThreadProcessId(child, &pid);
+        if (pid && pid != c->frame) {
+          c->found = pid;
+          return FALSE;
+        }
+        return TRUE;
+      },
+                       reinterpret_cast<LPARAM>(&ctx));
+      return ctx.found ? ctx.found : frame_pid;
+    }
+
+    /**
+     * @brief Processes owning a window that is actually visible on the streamed display.
+     *
+     * Windows are walked top to bottom; the part of each one not covered by the windows above it
+     * must be at least 0.5% of the display.
+     *
+     * @param processes Snapshot used to recognize UWP frames.
+     * @return Process identifiers, without duplicates.
+     */
+    std::vector<std::uint32_t> visible_window_owners(const std::vector<process_node_t> &processes) {
+      struct ctx_t {
+        RECT monitor;
+        std::int64_t monitor_area;
+        std::int64_t covered_area;
+        HRGN covered;
+        std::set<std::uint32_t> pids;
+        const std::vector<process_node_t> *processes;
+      } ctx {};
+      ctx.monitor = streamed_monitor_rect();
+      ctx.monitor_area = static_cast<std::int64_t>(ctx.monitor.right - ctx.monitor.left) * (ctx.monitor.bottom - ctx.monitor.top);
+      ctx.covered = CreateRectRgn(0, 0, 0, 0);
+      ctx.processes = &processes;
+      if (ctx.monitor_area <= 0 || !ctx.covered) {
+        return {};
+      }
+
+      EnumWindows([](HWND hwnd, LPARAM param) -> BOOL {
+        auto c = reinterpret_cast<ctx_t *>(param);
+        if (!window_is_drawn(hwnd)) {
+          return TRUE;
+        }
+        RECT rect {}, visible {};
+        if (!GetWindowRect(hwnd, &rect) || !IntersectRect(&visible, &rect, &c->monitor)) {
+          return TRUE;
+        }
+        HRGN region = CreateRectRgnIndirect(&visible);
+        if (!region) {
+          return TRUE;
+        }
+        CombineRgn(region, region, c->covered, RGN_DIFF);
+        auto area = region_area(region);
+        CombineRgn(c->covered, c->covered, region, RGN_OR);
+        DeleteObject(region);
+        c->covered_area += area;
+
+        if (area * 200 >= c->monitor_area) {
+          DWORD pid = 0;
+          GetWindowThreadProcessId(hwnd, &pid);
+          auto it = std::find_if(c->processes->begin(), c->processes->end(), [&](const auto &p) {
+            return p.pid == pid;
+          });
+          if (it != c->processes->end() && it->exe == L"applicationframehost.exe") {
+            pid = uwp_owner(hwnd, pid);
+          }
+          if (pid) {
+            c->pids.insert(pid);
+          }
+        }
+        // Stop once the display is fully covered: nothing below can be seen
+        return c->covered_area < c->monitor_area ? TRUE : FALSE;
+      },
+                  reinterpret_cast<LPARAM>(&ctx));
+
+      DeleteObject(ctx.covered);
+      return {ctx.pids.begin(), ctx.pids.end()};
+    }
+
+    /**
+     * @brief Windows build number, read without the compatibility shims of GetVersionEx.
+     *
+     * @return Build number, or 0 when unknown.
+     */
+    DWORD windows_build() {
+      using rtl_get_version_t = LONG(WINAPI *)(OSVERSIONINFOW *);
+      auto ntdll = GetModuleHandleW(L"ntdll.dll");
+      auto rtl_get_version = ntdll ? reinterpret_cast<rtl_get_version_t>(GetProcAddress(ntdll, "RtlGetVersion")) : nullptr;
+      OSVERSIONINFOW info {};
+      info.dwOSVersionInfoSize = sizeof(info);
+      if (!rtl_get_version || rtl_get_version(&info) != 0) {
+        return 0;
+      }
+      return info.dwBuildNumber;
+    }
+
+    /**
+     * @brief Completion handler for `ActivateAudioInterfaceAsync`.
+     */
+    class activation_handler_t: public IActivateAudioInterfaceCompletionHandler {
+    public:
+      /**
+       * @brief Create the handler with its completion event.
+       */
+      activation_handler_t():
+          done {CreateEventW(nullptr, TRUE, FALSE, nullptr)} {
+      }
+
+      /**
+       * @brief Close the completion event.
+       */
+      virtual ~activation_handler_t() {
+        if (client) {
+          client->Release();
+        }
+        if (done) {
+          CloseHandle(done);
+        }
+      }
+
+      /**
+       * @brief COM QueryInterface; the handler is agile (free-threaded).
+       *
+       * @param riid Requested interface.
+       * @param out Receives the interface.
+       * @return S_OK or E_NOINTERFACE.
+       */
+      HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **out) override {
+        // {94ea2b94-e9cc-49e0-c0ff-ee64ca8f5b90}: IAgileObject
+        static const GUID agile {0x94ea2b94, 0xe9cc, 0x49e0, {0xc0, 0xff, 0xee, 0x64, 0xca, 0x8f, 0x5b, 0x90}};
+        if (riid == __uuidof(IUnknown) || riid == __uuidof(IActivateAudioInterfaceCompletionHandler) || riid == agile) {
+          *out = static_cast<IActivateAudioInterfaceCompletionHandler *>(this);
+          AddRef();
+          return S_OK;
+        }
+        *out = nullptr;
+        return E_NOINTERFACE;
+      }
+
+      /**
+       * @brief COM AddRef.
+       *
+       * @return New reference count.
+       */
+      ULONG STDMETHODCALLTYPE AddRef() override {
+        return InterlockedIncrement(&refs);
+      }
+
+      /**
+       * @brief COM Release.
+       *
+       * @return New reference count.
+       */
+      ULONG STDMETHODCALLTYPE Release() override {
+        auto r = InterlockedDecrement(&refs);
+        if (!r) {
+          delete this;
+        }
+        return r;
+      }
+
+      /**
+       * @brief Store the activated client and wake the waiting thread.
+       *
+       * @param op Finished activation.
+       * @return Always S_OK.
+       */
+      HRESULT STDMETHODCALLTYPE ActivateCompleted(IActivateAudioInterfaceAsyncOperation *op) override {
+        HRESULT hr = E_FAIL;
+        IUnknown *unknown = nullptr;
+        if (SUCCEEDED(op->GetActivateResult(&hr, &unknown)) && SUCCEEDED(hr) && unknown) {
+          hr = unknown->QueryInterface(__uuidof(IAudioClient), reinterpret_cast<void **>(&client));
+        }
+        if (unknown) {
+          unknown->Release();
+        }
+        status = hr;
+        SetEvent(done);
+        return S_OK;
+      }
+
+      HANDLE done;  ///< Signaled when activation finished.
+      HRESULT status = E_PENDING;  ///< Activation result.
+      IAudioClient *client = nullptr;  ///< Activated client on success.
+
+    private:
+      LONG refs = 1;
+    };
+
+    /**
+     * @brief One captured process tree.
+     */
+    struct source_t {
+      DWORD pid = 0;  ///< Root of the captured tree.
+      std::wstring exe;  ///< Executable name, for logs.
+      IAudioClient *client = nullptr;  ///< Process loopback client.
+      IAudioCaptureClient *capture = nullptr;  ///< Capture service of `client`.
+      HANDLE event = nullptr;  ///< Signaled by WASAPI when a packet is ready.
+      std::deque<float> fifo;  ///< Interleaved samples waiting to be mixed (guarded by the mixer mutex).
+      bool primed = false;  ///< Whether enough audio is buffered to start mixing without gaps.
+      std::chrono::steady_clock::time_point last_seen;  ///< Last time a window of this tree was visible.
+      bool started = false;  ///< Whether `client` was started (stopping an idle loopback client crashes AudioSes).
+
+      /**
+       * @brief Stop and release the capture.
+       */
+      ~source_t() {
+        if (started) {
+          client->Stop();
+        }
+        if (capture) {
+          capture->Release();
+        }
+        if (client) {
+          client->Release();
+        }
+        if (event) {
+          CloseHandle(event);
+        }
+      }
+    };
+
+    /**
+     * @brief Open a process loopback capture for a process tree.
+     *
+     * @param pid Root process.
+     * @param format Requested capture format (32-bit float).
+     * @return Started source, or an empty pointer on failure.
+     */
+    std::shared_ptr<source_t> open_source(DWORD pid, const WAVEFORMATEXTENSIBLE &format) {
+      AUDIOCLIENT_ACTIVATION_PARAMS params {};
+      params.ActivationType = AUDIOCLIENT_ACTIVATION_TYPE_PROCESS_LOOPBACK;
+      params.ProcessLoopbackParams.TargetProcessId = pid;
+      params.ProcessLoopbackParams.ProcessLoopbackMode = PROCESS_LOOPBACK_MODE_INCLUDE_TARGET_PROCESS_TREE;
+
+      PROPVARIANT prop {};
+      prop.vt = VT_BLOB;
+      prop.blob.cbSize = sizeof(params);
+      prop.blob.pBlobData = reinterpret_cast<BYTE *>(&params);
+
+      auto handler = new activation_handler_t();
+      IActivateAudioInterfaceAsyncOperation *op = nullptr;
+      HRESULT hr = ActivateAudioInterfaceAsync(VIRTUAL_AUDIO_DEVICE_PROCESS_LOOPBACK, __uuidof(IAudioClient), &prop, handler, &op);
+      if (SUCCEEDED(hr) && WaitForSingleObject(handler->done, 2000) != WAIT_OBJECT_0) {
+        hr = E_PENDING;
+      }
+      if (SUCCEEDED(hr)) {
+        hr = handler->status;
+      }
+      auto source = std::make_shared<source_t>();
+      source->pid = pid;
+      if (SUCCEEDED(hr)) {
+        source->client = handler->client;
+        handler->client = nullptr;
+      }
+      if (op) {
+        op->Release();
+      }
+      handler->Release();
+      if (FAILED(hr) || !source->client) {
+        BOOST_LOG(warning) << "Process loopback activation failed for pid "sv << pid << ": 0x"sv << util::hex(hr).to_string_view();
+        return nullptr;
+      }
+
+      // Same flags as Microsoft's ApplicationLoopback sample; stereo uses a plain WAVEFORMATEX like the sample
+      constexpr DWORD flags = AUDCLNT_STREAMFLAGS_LOOPBACK | AUDCLNT_STREAMFLAGS_EVENTCALLBACK | AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM;
+      constexpr REFERENCE_TIME buffer_100ns = 200'000;  // 20 ms
+      WAVEFORMATEX plain = format.Format;
+      plain.wFormatTag = WAVE_FORMAT_IEEE_FLOAT;
+      plain.cbSize = 0;
+      auto requested = format.Format.nChannels <= 2 ? &plain : reinterpret_cast<const WAVEFORMATEX *>(&format);
+      hr = source->client->Initialize(AUDCLNT_SHAREMODE_SHARED, flags, buffer_100ns, 0, requested, nullptr);
+      if (FAILED(hr)) {
+        BOOST_LOG(warning) << "Process loopback initialization failed for pid "sv << pid << ": 0x"sv << util::hex(hr).to_string_view();
+        return nullptr;
+      }
+      source->event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+      if (!source->event) {
+        return nullptr;
+      }
+      hr = source->client->SetEventHandle(source->event);
+      if (SUCCEEDED(hr)) {
+        hr = source->client->GetService(__uuidof(IAudioCaptureClient), reinterpret_cast<void **>(&source->capture));
+      }
+      if (SUCCEEDED(hr)) {
+        hr = source->client->Start();
+      }
+      if (FAILED(hr)) {
+        BOOST_LOG(warning) << "Process loopback start failed for pid "sv << pid << ": 0x"sv << util::hex(hr).to_string_view();
+        return nullptr;
+      }
+      source->started = true;
+      return source;
+    }
+
+    /**
+     * @brief Mix of the process trees visible on the streamed display.
+     */
+    class mic_onscreen_t: public mic_t {
+    public:
+      /**
+       * @brief Prepare the capture format and buffering.
+       *
+       * @param channels Channel count.
+       * @param channel_mask Channel mask.
+       * @param sample_rate Sample rate in hertz.
+       * @param frame_size Samples per channel in each frame.
+       * @param continuous Whether to emit silence when nothing plays.
+       */
+      mic_onscreen_t(std::uint32_t channels, std::uint32_t channel_mask, std::uint32_t sample_rate, std::uint32_t frame_size, bool continuous):
+          channels {channels},
+          sample_rate {sample_rate},
+          frame_samples {frame_size * channels},
+          continuous {continuous},
+          excluded {excluded_apps(config::audio.exclude_apps)} {
+        format = {};
+        format.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+        format.Format.nChannels = static_cast<WORD>(channels);
+        format.Format.nSamplesPerSec = sample_rate;
+        format.Format.wBitsPerSample = 32;
+        format.Format.nBlockAlign = static_cast<WORD>(channels * 4);
+        format.Format.nAvgBytesPerSec = sample_rate * format.Format.nBlockAlign;
+        format.Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+        format.Samples.wValidBitsPerSample = 32;
+        format.dwChannelMask = channel_mask;
+        format.SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+
+        // One engine period (10 ms) of headroom absorbs the packet jitter; more than 30 ms is dropped
+        auto period = sample_rate / 100 * channels;
+        prime_samples = frame_samples + period;
+        max_samples = prime_samples + 2 * period;
+        frame_duration = std::chrono::nanoseconds(1'000'000'000ULL * frame_size / sample_rate);
+
+        timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+        if (!timer) {
+          timer = CreateWaitableTimerW(nullptr, TRUE, nullptr);
+        }
+        wake = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+      }
+
+      /**
+       * @brief Check that process loopback works, then start the worker threads.
+       *
+       * @return True when capture can start.
+       */
+      bool start() {
+        // Process loopback exists since Windows 10 2004 (build 19041)
+        if (windows_build() < 19041) {
+          return false;
+        }
+        watcher = std::thread {[this] {
+          watch();
+        }};
+        reader = std::thread {[this] {
+          read();
+        }};
+        return true;
+      }
+
+      /**
+       * @brief Stop the worker threads and release every capture.
+       */
+      ~mic_onscreen_t() override {
+        stopping = true;
+        stop_cv.notify_all();
+        if (wake) {
+          SetEvent(wake);
+        }
+        // The watcher joins the reader and releases the captures before exiting
+        if (watcher.joinable()) {
+          watcher.join();
+        }
+        if (timer) {
+          CloseHandle(timer);
+        }
+        if (wake) {
+          CloseHandle(wake);
+        }
+      }
+
+      /**
+       * @brief Wait for the next frame deadline and mix the buffered audio of every source.
+       *
+       * @param out Destination for interleaved float samples.
+       * @return ok, or timeout when nothing is playing and silence is not wanted.
+       */
+      capture_e sample(std::vector<float> &out) override {
+        wait_next_frame();
+
+        std::fill(out.begin(), out.end(), 0.0f);
+        auto need = std::min<std::size_t>(out.size(), frame_samples);
+        bool any = false;
+        {
+          std::lock_guard lock {mix_mutex};
+          for (auto &s : sources) {
+            auto &fifo = s->fifo;
+            if (!s->primed) {
+              if (fifo.size() < prime_samples) {
+                continue;
+              }
+              s->primed = true;
+            }
+            if (fifo.size() > max_samples) {
+              auto drop = (fifo.size() - prime_samples) / channels * channels;
+              fifo.erase(fifo.begin(), fifo.begin() + drop);
+            }
+            auto n = std::min(need, fifo.size());
+            for (std::size_t i = 0; i < n; ++i) {
+              out[i] += fifo[i];
+            }
+            fifo.erase(fifo.begin(), fifo.begin() + n);
+            if (n < need) {
+              s->primed = false;  // underrun: buffer again before mixing this source
+            }
+            any = any || n > 0;
+          }
+        }
+        for (auto &v : out) {
+          v = std::clamp(v, -1.0f, 1.0f);
+        }
+        return any || continuous ? capture_e::ok : capture_e::timeout;
+      }
+
+    private:
+      /**
+       * @brief Sleep until the next frame is due, resynchronizing after long stalls.
+       */
+      void wait_next_frame() {
+        auto now = std::chrono::steady_clock::now();
+        if (next_frame.time_since_epoch().count() == 0 || now - next_frame > 100ms) {
+          next_frame = now;
+        }
+        next_frame += frame_duration;
+        auto wait = std::chrono::duration_cast<std::chrono::nanoseconds>(next_frame - now);
+        if (wait.count() <= 0) {
+          return;
+        }
+        if (timer) {
+          LARGE_INTEGER due;
+          due.QuadPart = -static_cast<LONGLONG>(wait.count() / 100);
+          if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+            WaitForSingleObject(timer, 1000);
+            return;
+          }
+        }
+        std::this_thread::sleep_for(wait);
+      }
+
+      /**
+       * @brief Watcher thread: keep one source per visible process tree.
+       */
+      void watch() {
+        CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        std::wstring last_log;
+        while (!stopping) {
+          auto processes = snapshot_processes();
+          auto wanted = select_capture_roots(visible_window_owners(processes), processes, excluded);
+          if (wanted.size() > max_sources) {
+            wanted.resize(max_sources);
+          }
+          auto now = std::chrono::steady_clock::now();
+
+          std::vector<std::shared_ptr<source_t>> current;
+          {
+            std::lock_guard lock {mix_mutex};
+            current = sources;
+          }
+          std::map<DWORD, std::shared_ptr<source_t>> by_pid;
+          for (auto &s : current) {
+            by_pid[s->pid] = s;
+          }
+          std::vector<std::shared_ptr<source_t>> next;
+          for (auto pid : wanted) {
+            auto it = by_pid.find(pid);
+            if (it != by_pid.end()) {
+              it->second->last_seen = now;
+              continue;
+            }
+            if (auto s = open_source(pid, format)) {
+              auto p = std::find_if(processes.begin(), processes.end(), [&](const auto &n) {
+                return n.pid == pid;
+              });
+              s->exe = p != processes.end() ? p->exe : L"?";
+              s->last_seen = now;
+              next.push_back(std::move(s));
+            }
+          }
+          bool changed = !next.empty();
+          for (auto &s : current) {
+            if (now - s->last_seen <= grace_period) {
+              next.push_back(s);
+            } else {
+              changed = true;
+            }
+          }
+          if (changed) {
+            std::wstring names;
+            for (auto &s : next) {
+              names += (names.empty() ? L"" : L", ") + s->exe;
+            }
+            {
+              std::lock_guard lock {mix_mutex};
+              sources = next;
+            }
+            SetEvent(wake);
+            if (names != last_log) {
+              BOOST_LOG(info) << "On-screen audio: capturing ["sv << utf_utils::to_utf8(names) << ']';
+              last_log = names;
+            }
+          }
+
+          std::unique_lock lock {stop_mutex};
+          stop_cv.wait_for(lock, refresh_interval, [this] {
+            return stopping.load();
+          });
+        }
+        // Release the captures here: COM objects must not be released on a thread without COM
+        if (reader.joinable()) {
+          SetEvent(wake);
+          reader.join();
+        }
+        {
+          std::lock_guard lock {mix_mutex};
+          sources.clear();
+        }
+        CoUninitialize();
+      }
+
+      /**
+       * @brief Reader thread: move captured packets into the per-source buffers.
+       */
+      void read() {
+        CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        while (!stopping) {
+          std::vector<std::shared_ptr<source_t>> current;
+          {
+            std::lock_guard lock {mix_mutex};
+            current = sources;
+          }
+          std::vector<HANDLE> events {wake};
+          for (auto &s : current) {
+            if (events.size() < MAXIMUM_WAIT_OBJECTS) {
+              events.push_back(s->event);
+            }
+          }
+          WaitForMultipleObjects(static_cast<DWORD>(events.size()), events.data(), FALSE, 20);
+
+          for (auto &s : current) {
+            UINT32 packet = 0;
+            while (SUCCEEDED(s->capture->GetNextPacketSize(&packet)) && packet > 0) {
+              BYTE *data = nullptr;
+              UINT32 frames = 0;
+              DWORD flags = 0;
+              if (FAILED(s->capture->GetBuffer(&data, &frames, &flags, nullptr, nullptr))) {
+                break;
+              }
+              {
+                std::lock_guard lock {mix_mutex};
+                auto samples = static_cast<std::size_t>(frames) * channels;
+                if (flags & AUDCLNT_BUFFERFLAGS_SILENT || !data) {
+                  s->fifo.insert(s->fifo.end(), samples, 0.0f);
+                } else {
+                  auto f = reinterpret_cast<const float *>(data);
+                  s->fifo.insert(s->fifo.end(), f, f + samples);
+                }
+                // Never let a source that is not being mixed grow without bounds
+                if (s->fifo.size() > 4 * max_samples) {
+                  s->fifo.erase(s->fifo.begin(), s->fifo.begin() + (s->fifo.size() - max_samples) / channels * channels);
+                }
+              }
+              s->capture->ReleaseBuffer(frames);
+            }
+          }
+        }
+        CoUninitialize();
+      }
+
+      std::uint32_t channels;
+      std::uint32_t sample_rate;
+      std::size_t frame_samples;
+      bool continuous;
+      std::vector<std::wstring> excluded;
+      WAVEFORMATEXTENSIBLE format;
+      std::size_t prime_samples = 0;
+      std::size_t max_samples = 0;
+      std::chrono::nanoseconds frame_duration {};
+      std::chrono::steady_clock::time_point next_frame {};
+      HANDLE timer = nullptr;
+      HANDLE wake = nullptr;
+
+      std::mutex mix_mutex;
+      std::vector<std::shared_ptr<source_t>> sources;
+
+      std::atomic_bool stopping {false};
+      std::mutex stop_mutex;
+      std::condition_variable stop_cv;
+      std::thread watcher;
+      std::thread reader;
+    };
+  }  // namespace
+
+  std::vector<std::wstring> excluded_apps(const std::string &extra) {
+    std::vector<std::wstring> out(builtin_excluded.begin(), builtin_excluded.end());
+    auto list = utf_utils::from_utf8(extra);
+    std::size_t start = 0;
+    while (start <= list.size()) {
+      auto end = list.find(L',', start);
+      if (end == std::wstring::npos) {
+        end = list.size();
+      }
+      auto item = list.substr(start, end - start);
+      auto first = item.find_first_not_of(L" \t");
+      auto last = item.find_last_not_of(L" \t");
+      if (first != std::wstring::npos) {
+        item = lower(item.substr(first, last - first + 1));
+        if (item.size() < 4 || item.substr(item.size() - 4) != L".exe") {
+          item += L".exe";
+        }
+        if (!contains(out, item)) {
+          out.push_back(item);
+        }
+      }
+      start = end + 1;
+    }
+    return out;
+  }
+
+  std::vector<std::uint32_t> select_capture_roots(const std::vector<std::uint32_t> &candidates, const std::vector<process_node_t> &processes, const std::vector<std::wstring> &excluded) {
+    std::unordered_map<std::uint32_t, const process_node_t *> by_pid;
+    for (const auto &p : processes) {
+      by_pid[p.pid] = &p;
+    }
+    auto ancestors = [&](std::uint32_t pid) {
+      std::vector<std::uint32_t> chain;
+      auto it = by_pid.find(pid);
+      while (it != by_pid.end() && it->second->parent_valid && chain.size() < 64) {
+        auto parent = it->second->parent;
+        if (parent == 0 || parent == it->second->pid || std::find(chain.begin(), chain.end(), parent) != chain.end()) {
+          break;
+        }
+        chain.push_back(parent);
+        it = by_pid.find(parent);
+      }
+      return chain;
+    };
+    auto exe_of = [&](std::uint32_t pid) {
+      auto it = by_pid.find(pid);
+      return it != by_pid.end() ? it->second->exe : std::wstring {};
+    };
+
+    // Trees that contain an excluded application cannot be captured without leaking it
+    std::set<std::uint32_t> tainted;
+    for (const auto &p : processes) {
+      if (contains(excluded, p.exe)) {
+        tainted.insert(p.pid);
+        for (auto a : ancestors(p.pid)) {
+          tainted.insert(a);
+        }
+      }
+    }
+
+    std::set<std::uint32_t> pool;
+    for (auto pid : candidates) {
+      auto exe = exe_of(pid);
+      if (exe.empty() || contains(shell_processes, exe) || tainted.count(pid)) {
+        continue;
+      }
+      pool.insert(pid);
+    }
+
+    // A tree already includes its descendants: keep only the topmost candidates
+    std::vector<std::uint32_t> roots;
+    for (auto pid : pool) {
+      auto chain = ancestors(pid);
+      if (std::none_of(chain.begin(), chain.end(), [&](auto a) {
+            return pool.count(a) > 0;
+          })) {
+        roots.push_back(pid);
+      }
+    }
+    return roots;
+  }
+
+  std::unique_ptr<mic_t> make_onscreen_mic(std::uint32_t channels, std::uint32_t channel_mask, std::uint32_t sample_rate, std::uint32_t frame_size, bool continuous) {
+    auto mic = std::make_unique<mic_onscreen_t>(channels, channel_mask, sample_rate, frame_size, continuous);
+    if (!mic->start()) {
+      return nullptr;
+    }
+    BOOST_LOG(info) << "Capturing only the audio of applications visible on the streamed display"sv;
+    return mic;
+  }
+}  // namespace platf::audio
