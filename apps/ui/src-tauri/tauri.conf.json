{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falco",
  "mainBinaryName": "falco-ui",
  "version": "1.0.0-rc.12",
  "identifier": "app.falco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Falco",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0B0D16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Falco",
    "copyright": "GPL-3.0",
    "category": "Game",
    "shortDescription": "Gioca con gli amici. Veloce come un falco.",
    "longDescription": "Streaming di gioco tra amici, host e client, senza server di mezzo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../../../packaging/windows/hooks.nsh",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "../../../packaging/macos/entitlements.plist",
      "infoPlist": "../../../packaging/macos/Info.plist"
    }
  }
}
